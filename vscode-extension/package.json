{
  "name": "chronovault",
  "displayName": "CHRONOVAULT",
  "description": "Return to the moment your code still worked. Record verified checkpoints, find what broke, and restore the last good state — with automatic rollback.",
  "version": "1.0.0",
  "publisher": "chronovault",
  "author": {
    "name": "Saurav Kumar Bichha",
    "url": "https://github.com/100raav"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/100raav/chronovault",
  "repository": {
    "type": "git",
    "url": "https://github.com/100raav/chronovault.git"
  },
  "bugs": {
    "url": "https://github.com/100raav/chronovault/issues"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "checkpoint",
    "restore",
    "rollback",
    "recovery",
    "snapshot",
    "vault",
    "diagnose",
    "verified",
    "local-first",
    "backup"
  ],
  "galleryBanner": {
    "color": "#0a0f1e",
    "theme": "dark"
  },
  "icon": "icon.png",
  "readme": "readme.md",
  "changelog": "CHANGELOG.md",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:chronovault.checkpoint",
    "onCommand:chronovault.restore",
    "onCommand:chronovault.diagnose",
    "onCommand:chronovault.status",
    "onCommand:chronovault.dashboard"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "CHRONOVAULT",
      "properties": {
        "chronovault.cliPath": {
          "type": "string",
          "default": "chronovault",
          "description": "Path to the chronovault CLI executable (default: on PATH)."
        }
      }
    },
    "commands": [
      { "command": "chronovault.checkpoint", "title": "ChronoVault: Create checkpoint", "icon": "$(save)" },
      { "command": "chronovault.restore", "title": "ChronoVault: Restore last good state", "icon": "$(history)" },
      { "command": "chronovault.diagnose", "title": "ChronoVault: What broke it?", "icon": "$(debug-alt)" },
      { "command": "chronovault.status", "title": "ChronoVault: Show protection status", "icon": "$(shield)" },
      { "command": "chronovault.dashboard", "title": "ChronoVault: Open dashboard", "icon": "$(globe)" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "chronovault.checkpoint" },
        { "command": "chronovault.restore" },
        { "command": "chronovault.diagnose" },
        { "command": "chronovault.status" },
        { "command": "chronovault.dashboard" }
      ]
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "publish": "vsce publish --no-dependencies --allow-missing-repository",
    "lint": "node --check extension.js"
  }
}